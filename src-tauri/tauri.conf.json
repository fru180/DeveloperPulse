{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeveloperPulse",
  "version": "0.1.0",
  "identifier": "app.developerpulse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://localhost:1420/",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "windows": [
      {
        "title": "DeveloperPulse",
        "width": 864,
        "height": 330,
        "minWidth": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    }
  }
}
